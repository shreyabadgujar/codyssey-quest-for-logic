# ---- Backend (copy to backend/.env) ----
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codyssey
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Judge0 (server-side only, never expose to the frontend)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=replace-me

# ---- Frontend (copy to frontend/.env) ----
# Optional. Defaults to "/api" which Vite proxies to the backend in dev.
VITE_API_URL=/api
